{
  "name": "medigap-compare-data",
  "version": "1.0.0",
  "description": "Self-contained Medigap price comparison data package — compare Medicare Supplement plans by zip code, age, and marital status",
  "main": "medigap.js",
  "module": "medigap.esm.js",
  "exports": {
    ".": {
      "import": "./medigap.esm.js",
      "require": "./medigap.js"
